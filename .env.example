# Copy this file to ".env" (same folder), fill it in, then run: npm start

# --- SMS (Twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=          # your Twilio number in international format, e.g. +12025550123

# --- Email (Gmail example) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=            # e.g. yourname@gmail.com
SMTP_PASS=            # a Google "App password" (16 letters), NOT your normal password
MAIL_FROM=            # e.g. Thulamela Municipality <yourname@gmail.com>

# --- Security (required when NODE_ENV=production) ---
JWT_SECRET=change-this-to-a-long-random-text
# NODE_ENV=production   # uncomment to stop the on-screen SMS/email pop-ups
